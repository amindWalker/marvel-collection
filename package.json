{
  "name": "marvel-collection",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "unocss": "unocss \"app/src/**/*.tsx\" -o app/src/App.css -w",
    "dev:unocss": "concurrently 'vite --host' 'unocss \"app/src/**/*.tsx\" -o app/src/App.css -w' ",
    "build:css": "unocss \"src/**/*.tsx\" --out-file=css/uno.css",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "react-router-dom": "7.5.3",
    "redux": "5.0.1"
  },
  "devDependencies": {
    "@iconify/json": "2.2.333",
    "@iconify/types": "2.0.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@typescript-eslint/eslint-plugin": "8.31.1",
    "@typescript-eslint/parser": "8.31.1",
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "9.1.2",
    "eslint": "9.25.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "typescript": "5.8.3",
    "unocss": "66.0.0",
    "vite": "6.3.3"
  }
}